# Template only. Copy to supabase/.env (git-ignored) for local `supabase functions serve`.
# Never commit real values. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed Edge Functions by the Supabase platform.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_ORIGIN=http://localhost:5173
